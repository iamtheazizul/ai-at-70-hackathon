# Copy to .env. Do not commit .env. This repository is public.

# --- Browser (shipped to the client, safe) ---------------------------------
# Supabase dashboard -> Project Settings -> API.
# The publishable key is meant to be public: every table is select-only to
# anon under RLS, so this grants read access to demonstration rows only.
VITE_SUPABASE_URL=https://gflmdpdcairhkewtdzqs.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Same values, for the Node scripts.
SUPABASE_URL=https://gflmdpdcairhkewtdzqs.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# --- Schema changes (secret, local only) -----------------------------------
# Only `npm run apply-schema` reads this, and only from your machine.
# Dashboard -> Project Settings -> Database -> Connection string -> URI,
# the one labelled Session pooler. It contains the database password.
SUPABASE_DB_URL=
